{
    "name": "blaetter/pepgen",
    "type": "project",
    "version": "2.0.0-dev",
    "description": "Personalized ePub Generation",
    "authors": [
        {
            "name": "Andreas Mängel"
        }
    ],
    "prefer-stable": true,
    "minimum-stability": "beta",
    "require": {
        "php": ">=8.2",
        "monolog/monolog": "^3.0",
        "symfony/console": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/process": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.11",
        "php-coveralls/php-coveralls": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Pepgen\\": "app/modules"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pepgen\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
